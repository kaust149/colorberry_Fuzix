# Inittab for the ColorBerry (RP2040-PiZero)
id:3:initdefault:
# Run level s - a shell
is:s:respawn:/bin/sh
# Start up
rc::bootwait:/etc/rc
# Terminals
# tty1 is the built-in LCD and keyboard: 66 columns x 30 rows
01:3:respawn:getty /dev/tty1 38400 colorberry 66 30
# tty2 is USB serial, tty3 is UART0. Switch to respawn to log in there
# (each getty costs memory, so they are off by default)
02:3:off:getty /dev/tty2
03:3:off:getty /dev/tty3
# Reboot
bt:5:wait:/etc/rc.reboot
# Shutdown
ht:6:wait:/etc/rc.halt
